    { "name": "bellsoft-liberica", "image": "bellsoft-liberica-dev" },
    { "name": "eclipse-openj9", "image": "eclipse-openj9-dev" },
    { "name": "graalvm", "image": "graalvm-dev" },
    { "name": "microsoft-openjdk", "image": "microsoft-openjdk-dev" },
